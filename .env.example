# ══════════════════════════════════════════════════════════════════
#  MAGNO Sistema — Variables de Entorno (PRODUCCIÓN / HETZNER)
#  Copia este archivo: cp .env.example .env  y rellena cada valor.
#  NUNCA subas .env al repositorio (ya está en .gitignore).
# ══════════════════════════════════════════════════════════════════

# ── Base de datos ────────────────────────────────────────────────
DB_USER=magno
# Genera con: openssl rand -base64 24
DB_PASS=changeme_contraseña_segura

# ── Redis ────────────────────────────────────────────────────────
# Genera con: openssl rand -base64 24
REDIS_PASS=changeme_redis

# ── JWT ──────────────────────────────────────────────────────────
# Genera con: openssl rand -base64 64   (mínimo 256 bits)
JWT_SECRET=CHANGE_ME_AT_LEAST_256_BITS_LONG

# ── S3 / Almacenamiento de archivos ──────────────────────────────
# Hetzner Object Storage → console.hetzner.com → Object Storage
# Regiones: fsn1 (Falkenstein) | nbg1 (Nuremberg) | hel1 (Helsinki)
# Crea el bucket "magno-files" y genera credenciales S3 ahí mismo.
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=eu-central-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET=magno-files
# URL pública: https://{bucket}.{region}.your-objectstorage.com
S3_PUBLIC_URL=https://magno-files.fsn1.your-objectstorage.com

# ── Email ────────────────────────────────────────────────────────
# Gmail: crea una App Password en myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_correo@gmail.com
MAIL_PASS=changeme_app_password_16_chars

# ── CORS ─────────────────────────────────────────────────────────
# Nota: el perfil prod del backend usa "*" por defecto en el YAML.
# Cambia application.yml si quieres restringir a tu dominio.
CORS_ORIGINS=https://tu-dominio.com
