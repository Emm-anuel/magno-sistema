# ── Base de datos ─────────────────────────────────────────────────────
DB_USER=magno
DB_PASS=changeme

# ── Redis ────────────────────────────────────────────────────────────
REDIS_PASS=changeme

# ── JWT ──────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_AT_LEAST_256_BITS_LONG

# ── S3 / Almacenamiento de archivos ──────────────────────────────────
# Hetzner Object Storage (producción) o MinIO (on-premise)
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=eu-central-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET=magno-files
S3_PUBLIC_URL=https://magno-files.fsn1.your-objectstorage.com

# ── Email ────────────────────────────────────────────────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=noreply@magno.com
MAIL_PASS=changeme

# ── CORS ─────────────────────────────────────────────────────────────
CORS_ORIGINS=https://tu-dominio.com
